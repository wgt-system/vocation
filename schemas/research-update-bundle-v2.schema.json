{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocation.local/contracts/research-update-bundle-v2.schema.json",
  "title": "Vocation Research Update Bundle 2.0",
  "type": "object",
  "required": ["bundle_version", "bundle_id", "generated_at", "prompt_context_ref", "research_scope", "sources", "source_references", "companies", "opportunities", "postings", "observations", "assessments", "possible_duplicates", "warnings"],
  "properties": {
    "bundle_version": {"const": "2.0"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "prompt_context_ref": {"$ref": "#/$defs/correlation_ref"},
    "research_scope": {"$ref": "#/$defs/research_scope"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "source_references": {"type": "array", "items": {"$ref": "#/$defs/source_reference"}},
    "companies": {"type": "array", "items": {"$ref": "#/$defs/company"}},
    "opportunities": {"type": "array", "items": {"$ref": "#/$defs/opportunity"}},
    "postings": {"type": "array", "items": {"$ref": "#/$defs/posting"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}},
    "possible_duplicates": {"type": "array", "items": {"$ref": "#/$defs/possible_duplicate"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"research_scope": {"properties": {"type": {"const": "company_update"}}}}}, "then": {"properties": {"companies": {"items": {"$ref": "#/$defs/known_company"}}}}},
    {"if": {"properties": {"research_scope": {"properties": {"type": {"const": "opportunity_update"}}}}}, "then": {"properties": {"companies": {"items": {"$ref": "#/$defs/known_company"}}, "opportunities": {"items": {"$ref": "#/$defs/known_opportunity"}}}}},
    {"if": {"properties": {"research_scope": {"properties": {"type": {"const": "gap_filling"}}}}}, "then": {"properties": {"companies": {"items": {"$ref": "#/$defs/known_company"}}, "opportunities": {"items": {"$ref": "#/$defs/known_opportunity"}}, "postings": {"items": {"$ref": "#/$defs/known_posting"}}, "possible_duplicates": {"maxItems": 0}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "correlation_ref": {"type": "string", "pattern": "^ctx_[A-Za-z0-9_-]{8,200}$"},
    "subject_type": {"enum": ["company", "opportunity", "posting"]},
    "research_scope": {
      "type": "object",
      "required": ["type", "as_of_date"],
      "properties": {
        "type": {"enum": ["full_update", "company_update", "opportunity_update", "gap_filling"]},
        "as_of_date": {"type": "string", "format": "date"},
        "selected_correlation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/correlation_ref"}},
        "requests": {"type": "array", "items": {"$ref": "#/$defs/gap_request"}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "full_update"}}}, "then": {"not": {"required": ["selected_correlation_refs", "requests"]}}},
        {"if": {"properties": {"type": {"const": "gap_filling"}}}, "then": {"required": ["selected_correlation_refs", "requests"]}},
        {"if": {"properties": {"type": {"enum": ["company_update", "opportunity_update"]}}}, "then": {"required": ["selected_correlation_refs"]}}
      ],
      "additionalProperties": false
    },
    "gap_request": {
      "type": "object",
      "required": ["subject_type", "correlation_ref"],
      "properties": {
        "subject_type": {"enum": ["company", "opportunity", "posting"]},
        "correlation_ref": {"$ref": "#/$defs/correlation_ref"},
        "observation_type": {"enum": ["technology_requirement", "task", "seniority", "experience_requirement", "work_model", "salary"]},
        "criterion_id": {"$ref": "#/$defs/id"}
      },
      "oneOf": [{"required": ["observation_type"]}, {"required": ["criterion_id"]}],
      "additionalProperties": false
    },
    "https_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
    "source": {
      "type": "object", "required": ["id", "name", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "type": {"enum": ["company_careers", "job_board", "professional_network", "other"]}, "base_url": {"$ref": "#/$defs/https_url"}, "notes": {"type": "string"}},
      "additionalProperties": false
    },
    "source_reference": {
      "type": "object", "required": ["id", "source_id", "url", "observed_at"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "url": {"$ref": "#/$defs/https_url"}, "external_reference_id": {"type": "string", "minLength": 1}, "display_label": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}},
      "additionalProperties": false
    },
    "work_location": {
      "type": "object", "required": ["label", "precision", "source_reference_id", "observed_at"],
      "properties": {"label": {"type": "string", "minLength": 1}, "city": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1}, "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}, "precision": {"enum": ["exact_address", "site", "city", "region", "approximate", "unknown"]}, "source_reference_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_summary": {"type": "string"}},
      "additionalProperties": false
    },
    "company": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "correlation_ref": {"$ref": "#/$defs/correlation_ref"}, "canonical_name": {"type": "string", "minLength": 1}, "alternative_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "source_reference_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_summary": {"type": "string"}},
      "oneOf": [{"$ref": "#/$defs/known_company"}, {"$ref": "#/$defs/new_company"}],
      "additionalProperties": false
    },
    "known_company": {"type": "object", "required": ["id", "correlation_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "correlation_ref": {"$ref": "#/$defs/correlation_ref"}}, "additionalProperties": false},
    "new_company": {"type": "object", "required": ["id", "canonical_name", "source_reference_id", "observed_at"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonical_name": {"type": "string", "minLength": 1}, "alternative_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "source_reference_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_summary": {"type": "string"}}, "additionalProperties": false},
    "opportunity": {
      "type": "object", "required": ["id", "company_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"}, "correlation_ref": {"$ref": "#/$defs/correlation_ref"}, "canonical_title": {"type": "string", "minLength": 1}, "source_reference_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_summary": {"type": "string"}, "work_locations": {"type": "array", "items": {"$ref": "#/$defs/work_location"}}},
      "oneOf": [{"$ref": "#/$defs/known_opportunity"}, {"$ref": "#/$defs/new_opportunity"}], "additionalProperties": false
    },
    "known_opportunity": {"type": "object", "required": ["id", "company_id", "correlation_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"}, "correlation_ref": {"$ref": "#/$defs/correlation_ref"}}, "additionalProperties": false},
    "new_opportunity": {"type": "object", "required": ["id", "company_id", "canonical_title", "source_reference_id", "observed_at", "work_locations"], "properties": {"id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"}, "canonical_title": {"type": "string", "minLength": 1}, "source_reference_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_summary": {"type": "string"}, "work_locations": {"type": "array", "items": {"$ref": "#/$defs/work_location"}}}, "additionalProperties": false},
    "posting": {
      "type": "object", "required": ["id", "company_id", "opportunity_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"}, "opportunity_id": {"$ref": "#/$defs/id"}, "correlation_ref": {"$ref": "#/$defs/correlation_ref"}, "source_reference_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "external_posting_id": {"type": "string", "minLength": 1}, "canonical_url": {"$ref": "#/$defs/https_url"}, "published_at": {"type": "string", "format": "date"}, "observed_at": {"type": "string", "format": "date-time"}, "content_fingerprint": {"type": "string", "minLength": 1}},
      "oneOf": [{"$ref": "#/$defs/known_posting"}, {"$ref": "#/$defs/new_posting"}], "additionalProperties": false
    },
    "known_posting": {"type": "object", "required": ["id", "company_id", "opportunity_id", "correlation_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"}, "opportunity_id": {"$ref": "#/$defs/id"}, "correlation_ref": {"$ref": "#/$defs/correlation_ref"}}, "additionalProperties": false},
    "new_posting": {"type": "object", "required": ["id", "company_id", "opportunity_id", "source_reference_id", "title", "observed_at"], "properties": {"id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"}, "opportunity_id": {"$ref": "#/$defs/id"}, "source_reference_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "external_posting_id": {"type": "string", "minLength": 1}, "canonical_url": {"$ref": "#/$defs/https_url"}, "published_at": {"type": "string", "format": "date"}, "observed_at": {"type": "string", "format": "date-time"}, "content_fingerprint": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "claim_value": {"oneOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "array", "items": {"type": "string"}}]},
    "observation": {"type": "object", "required": ["id", "subject_type", "subject_id", "type", "value", "source_reference_id", "observed_at"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_type": {"$ref": "#/$defs/subject_type"}, "subject_id": {"$ref": "#/$defs/id"}, "type": {"enum": ["technology_requirement", "task", "seniority", "experience_requirement", "work_model", "salary"]}, "value": {"$ref": "#/$defs/claim_value"}, "source_reference_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_summary": {"type": "string"}}, "additionalProperties": false},
    "assessment": {"type": "object", "required": ["id", "subject_type", "subject_id", "criterion_id", "value", "origin", "source_reference_ids", "created_at"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_type": {"$ref": "#/$defs/subject_type"}, "subject_id": {"$ref": "#/$defs/id"}, "criterion_id": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/claim_value"}, "origin": {"const": "external_research"}, "source_reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "created_at": {"type": "string", "format": "date-time"}, "reasoning": {"type": "string"}}, "additionalProperties": false},
    "possible_duplicate": {"type": "object", "required": ["id", "subject_type", "left_subject_id", "right_subject_id", "source_reference_ids", "evidence_summary"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_type": {"enum": ["opportunity", "posting"]}, "left_subject_id": {"$ref": "#/$defs/id"}, "right_subject_id": {"$ref": "#/$defs/id"}, "source_reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_summary": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}
  }
}
