{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocation.local/contracts/published-map-projection-v1.schema.json",
  "title": "Published Map Projection 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability", "contract_version", "publication", "features"],
  "properties": {
    "capability": { "const": "vocation.map_projection" },
    "contract_version": { "const": "1.0" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_ref", "generated_at"],
      "properties": {
        "publication_ref": { "$ref": "#/$defs/opaque_ref" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_ref", "opportunity_ref", "title", "company", "work_location", "coordinates"],
        "properties": {
          "feature_ref": { "$ref": "#/$defs/opaque_ref" },
          "opportunity_ref": { "$ref": "#/$defs/opaque_ref" },
          "title": { "type": "string", "minLength": 1 },
          "company": {
            "type": "object",
            "additionalProperties": false,
            "required": ["company_ref", "name"],
            "properties": {
              "company_ref": { "$ref": "#/$defs/opaque_ref" },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "work_location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "precision"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "precision": {
                "enum": ["exact_address", "site", "city", "region", "approximate", "unknown"]
              }
            }
          },
          "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "opaque_ref": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
