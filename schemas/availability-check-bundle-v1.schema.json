{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocation.local/contracts/availability-check-bundle-v1.schema.json",
  "title": "Availability Check Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_kind",
    "bundle_version",
    "bundle_id",
    "generated_at",
    "prompt_context_ref",
    "research_scope",
    "observations",
    "warnings"
  ],
  "properties": {
    "bundle_kind": { "const": "availability_check" },
    "bundle_version": { "const": "1.0" },
    "bundle_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "generated_at": { "type": "string", "format": "date-time" },
    "prompt_context_ref": { "$ref": "#/$defs/opaque_ref" },
    "research_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "as_of_date", "selected_correlation_refs"],
      "properties": {
        "type": { "const": "availability_check" },
        "as_of_date": { "type": "string", "format": "date" },
        "selected_correlation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaque_ref" }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "posting_correlation_ref", "result", "observed_at", "evidence_summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "posting_correlation_ref": { "$ref": "#/$defs/opaque_ref" },
          "result": {
            "enum": [
              "explicitly_available",
              "explicitly_unavailable",
              "temporarily_unreachable",
              "not_found",
              "indeterminate"
            ]
          },
          "observed_at": { "type": "string", "format": "date-time" },
          "evidence_summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "opaque_ref": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
